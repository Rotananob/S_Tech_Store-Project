# ─── Environment Variables ─────────────────────────────────────────────────────
APP_NAME="S Tech Store API"
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=s_tech_store
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Path to your serviceAccountKey.json (NEVER commit this file!)
FIREBASE_CREDENTIALS=storage/app/firebase/serviceAccountKey.json
FIREBASE_PROJECT_ID=your_project_id

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="no-reply@stechstore.com"
MAIL_FROM_NAME="S Tech Store"

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Cache / Queue ────────────────────────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
