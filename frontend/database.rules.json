{
  "rules": {
    "chats": {
      ".read": true,
      ".write": true,
      "$chatId": {
        ".read": true,
        ".write": true,
        "messages": {
          ".read": true,
          ".write": true,
          "$messageId": {
            ".validate": "newData.hasChildren(['text', 'timestamp', 'sender']) && newData.child('text').isString() && newData.child('text').val().length <= 3000"
          }
        },
        "meta": {
          ".read": true,
          ".write": true
        }
      }
    },
    "rate_limits": {
      ".read": true,
      ".write": true
    }
  }
}
