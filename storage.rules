rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat uploads (images / slips / attachments)
    match /chats/{chatId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User profile avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Payment receipts & slips
    match /payments/{paymentId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Product images & general assets
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all: block unauthorized writes & executions
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
